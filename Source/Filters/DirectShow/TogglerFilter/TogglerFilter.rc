IDD_TOGGLE_DIALOG DIALOGEX 0, 0, 220, 190
STYLE DS_SETFONT | DS_FIXEDSYS | WS_CHILD | WS_SYSMENU
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Target Width:",IDC_STATIC,17,33,56,8
    LTEXT           "Target Height:",IDC_STATIC,16,48,59,8
    EDITTEXT        IDC_EDIT_TARGET_WIDTH,78,29,40,14,ES_AUTOHSCROLL
    CONTROL         "",IDC_SPIN1,"msctls_updown32",UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS,117,29,10,14
    EDITTEXT        IDC_EDIT_TARGET_HEIGHT,78,45,40,14,ES_AUTOHSCROLL
    CONTROL         "",IDC_SPIN2,"msctls_updown32",UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS,117,45,10,14
    LTEXT           "[s]  Use 0 for disable toggling",IDC_STATIC,139,88,66,25
    LTEXT           "Use 0 for populating input video size.",IDC_STATIC,37,62,167,11
    CONTROL         "Synchronise video by throttling",IDC_CHECK_THROTTLE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,18,126,178,10
    CONTROL         "Always duplicate frames on output",IDC_CHECK_DUPLICATE_FRAMES,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,18,139,187,10
    LTEXT           "Input duration:",IDC_STATIC,16,94,59,8
    EDITTEXT        IDC_EDIT_TOGGLE_DURATION,77,90,52,14,ES_AUTOHSCROLL
    CONTROL         "Input1 (unchecked) / Input 2 (checked)",IDC_CHECK_TOGGLE_INPUT,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,18,112,178,10
    CONTROL         "Vertical flip",IDC_CHECK_INVERT,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,18,154,187,10
    LTEXT           "Request:",IDC_STATIC,86,17,44,8
    LTEXT           "Actual output:",IDC_STATIC,143,17,58,8
    EDITTEXT        IDC_EDIT_ACT_WIDTH,142,26,40,14,ES_AUTOHSCROLL | ES_READONLY
    EDITTEXT        IDC_EDIT_ACT_HEIGHT,141,46,40,14,ES_AUTOHSCROLL | ES_READONLY
